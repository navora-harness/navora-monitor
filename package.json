{
  "name": "navora-monitor",
  "version": "0.3.30",
  "private": false,
  "license": "MIT",
  "author": "Navora",
  "description": "Navora Monitor — LAN CCTV preview, recording, and playback (FFmpeg)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navora-harness/navora-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/navora-harness/navora-monitor/issues"
  },
  "homepage": "https://github.com/navora-harness/navora-monitor#readme",
  "main": "server/cmd/navora",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "go -C server run ./cmd/navora",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build && node scripts/stage-web.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "start": "go -C server run ./cmd/navora",
    "ffmpeg:import": "node scripts/import-ffmpeg.mjs",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg.mjs",
    "ffmpeg:fetch:all": "node scripts/fetch-ffmpeg.mjs --all",
    "dist:go": "node scripts/dist-go.mjs",
    "dist:go:portable": "node scripts/dist-go.mjs portable",
    "dist:go:setup": "node scripts/dist-go.mjs setup",
    "dist:go:linux": "node scripts/dist-go.mjs linux-x64 portable",
    "dist:go:win": "node scripts/dist-go.mjs win-x64",
    "installer:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer-assets.ps1"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "mpegts.js": "^1.8.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9",
    "vue-tsc": "^2.2.8"
  },
  "engines": {
    "node": ">=20"
  }
}
