node_modules/
dist/
dist-electron/
dist-go/
release/
electron-builder.pack.json

# Local archive of retired Electron sources / old packages (do not commit)
_recycle/

# Local runtime data (may contain RTSP credentials, recordings, layout)
portable/**
!portable/channels.example.json
# recording-session.json is local runtime state (channel ids); keep out of git

# Bundled FFmpeg binaries are large GPL artifacts — fetch locally, do not commit
vendor/ffmpeg/**/ffmpeg
vendor/ffmpeg/**/ffmpeg.exe
vendor/.ffmpeg-extract/
vendor/.ffmpeg-cache/

# Secrets / local env
.env
.env.*
*.pem
*.key
credentials*.json
secrets*.json

*.log
.DS_Store
Thumbs.db
*.local
.vscode/
.idea/

.navora-dev-data/

# Vite output staged into the Go embed tree (keep an embed target in fresh clones)
server/internal/webui/files/*
!server/internal/webui/files/.gitkeep

# Temporary files, coverage reports and TypeScript incremental caches
*.tmp
*.temp
*.bak
*.tsbuildinfo
coverage/
.vite/

# Companion media metadata probes
vendor/ffmpeg/**/ffprobe
vendor/ffmpeg/**/ffprobe.exe
